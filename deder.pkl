amends "https://sake92.github.io/deder/config/v0.7.7/DederProject.pkl"

local const baseTemplate: ScalaModule = new {
  scalaVersion = "3.7.3"
  publish = false
  scalacOptions {
    "-Yretain-trees" // required for default arguments
    "-deprecation"
    "-Xcheck-macros"
  }
  publishTo = new SonatypeCentralRepo {
    id = "sonatype"
  }
}

local const basePomSettings: PomSettings = new {
  groupId = "ba.sake"
  url = "https://github.com/sake92/tupson"
  licenses {
    new PomLicense {
      name = "Apache 2.0 License"
      url = "https://opensource.org/license/apache-2.0"
    }
  }
  developers {
    new PomDeveloper {
      id = "sake92"
      name = "Sakib Hadžiavdić"
      email = "sake92@sake.ba"
    }
  }
  scm {
    url = "git@github.com:sake92/tupson.git"
  }
}

local const tupsonModules =
  new CreateCrossModules {
    root = "tupson"
    template = (baseTemplate) {
      publish = true
      deps {
        "org.typelevel::jawn-ast::1.6.0"
      }
      pomSettings = (basePomSettings) {
        artifactId = "tupson"
        name = "Tupson JSON library"
        description = "Tupson JSON library"
      }
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit::1.0.0"
      }
    }
    jsTemplate = (template.asJs()) {
      scalaJsVersion = "1.20.1"
      deps {
        "io.github.cquiroz::scala-java-time::2.6.0"
        // needed for ZoneId region lookups on JS (tzdb data is code-generated at link time)
        "io.github.cquiroz::scala-java-time-tzdb::2.6.0"
      }
    }
    jsTestTemplate = (jsTemplate.asTest()) {
      deps {
        "org.scalameta::munit::1.0.0"
      }
    }
    nativeTemplate = (template.asNative()) {
      // 0.5.10 to match Deder's embedded SN tools and sttp's published Native artifacts
      scalaNativeVersion = "0.5.10"
      deps {
        "io.github.cquiroz::scala-java-time::2.6.0"
        // needed for ZoneId region lookups on Native
        "io.github.cquiroz::scala-java-time-tzdb::2.6.0"
      }
    }
    nativeTestTemplate = (nativeTemplate.asTest()) {
      deps {
        "org.scalameta::munit::1.0.0"
      }
    }
  }.get

local const sttpVersion = "4.0.21" // newest sttp compatible with Deder 0.7.7 toolchain (Scala.js 1.20.2, Scala Native 0.5.10)

local const tupsonSttpBase = (baseTemplate) {
  publish = true
  deps {
    "com.softwaremill.sttp.client4::core::\(sttpVersion)"
    "com.softwaremill.sttp.client4::json-common::\(sttpVersion)"
  }
  pomSettings = (basePomSettings) {
    artifactId = "tupson-sttp"
    name = "Tupson sttp client module"
    description = "Tupson sttp client integration"
  }
}

local const tupsonSttpModules =
  new CreateCrossModules {
    root = "tupson-sttp"
    template = (tupsonSttpBase) {
      moduleDeps {
        tupsonModules.jvm
      }
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit::1.0.0"
      }
    }
    jsTemplate = (tupsonSttpBase.asJs()) {
      // keep in sync with the tupson core module (sttp 4.0.21 JS artifacts are IR 1.20-compatible)
      scalaJsVersion = "1.20.1"
      moduleDeps {
        tupsonModules.js
      }
    }
    jsTestTemplate = (jsTemplate.asTest()) {
      deps {
        "org.scalameta::munit::1.0.0"
      }
    }
    nativeTemplate = (tupsonSttpBase.asNative()) {
      // keep in sync with the tupson core module and sttp 4.0.21 Native artifacts (all 0.5.10)
      scalaNativeVersion = "0.5.10"
      moduleDeps {
        tupsonModules.native
      }
    }
    nativeTestTemplate = (nativeTemplate.asTest()) {
      deps {
        "org.scalameta::munit::1.0.0"
      }
    }
  }.get

local const tupsonConfigModules =
  new CreateScalaModules {
    root = "tupson-config"
    template = (baseTemplate) {
      publish = true
      moduleDeps {
        tupsonModules.jvm
      }
      deps {
        "com.typesafe:config:1.4.3"
      }
      pomSettings = (basePomSettings) {
        artifactId = "tupson-config"
        name = "Tupson Config module"
        description = "Tupson Config module"
      }
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit::1.0.0"
      }
      jvmOptions {
        "-Dconfig.override_with_env_vars=true"
      }
      forkEnv {
        ["CONFIG_FORCE_envvar_port"] = "1234"
      }
    }
  }.get

local const examples = (baseTemplate) {
  id = "examples"
  root = "examples"
  moduleDeps {
    tupsonModules.jvm
    tupsonSttpModules.jvm
  }
  deps {
    "com.softwaremill.sttp.client4::core::\(sttpVersion)"
  }
}

modules {
  ...tupsonModules.all
  ...tupsonConfigModules.all
  ...tupsonSttpModules.all
  examples
}
